---
interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Ready for a website that brings in new clients?',
  text = "Book a free, no-pressure consultation. I'll review your current site and show you exactly what I'd improve.",
} = Astro.props;
---

<section class="cta">
  <div class="container">
    <div class="cta-inner">
      <div>
        <h2>{heading}</h2>
        <p>{text}</p>
      </div>
      <a href="/contact" class="btn cta-btn">Book a free consultation</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-gap);
  }

  .cta-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, #0B2233 0%, #0B5E68 60%, #0B7A85 100%);
    overflow: hidden;
  }

  .cta-inner::after {
    content: '';
    position: absolute;
    right: -80px;
    bottom: -120px;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    border: 40px solid rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }

  h2 {
    color: #fff;
    margin-bottom: 0.6rem;
    max-width: 22ch;
  }

  p {
    color: #CDE6EC;
    max-width: 55ch;
  }

  .cta-btn {
    background: #fff;
    color: #0B2233;
    position: relative;
    z-index: 1;
  }

  .cta-btn:hover {
    background: #E6F7F9;
  }

  @media (max-width: 760px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
