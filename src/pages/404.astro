---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="page-header not-found">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>Looks like this page sprang a leak.</h1>
      <p class="lead">The page you're looking for doesn't exist or has moved.</p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/contact" class="btn btn-ghost">Contact me</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding-block: 7rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
</style>
